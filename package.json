{
  "name": "grokbot-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
